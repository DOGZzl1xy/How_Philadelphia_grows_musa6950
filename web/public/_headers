# Cloudflare static asset headers.
# /assets: file names carry a content hash (Vite). /data: every URL carries the build version (?v=, src/data.js).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/data/*
  Cache-Control: public, max-age=31536000, immutable
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
